<script is:inline>
  document.addEventListener('click', (e) => {
    const el = e.target.closest && e.target.closest('.buy-btn');
    if (!el || typeof window.gtag !== 'function') return;
    const price = Number(el.dataset.itemPrice || 0);
    const placement = el.dataset.placement || '';
    window.gtag('event', 'begin_checkout', {
      currency: 'USD',
      value: price,
      placement,
      items: [{
        item_id: el.dataset.itemId || 'unknown',
        item_name: 'Q-Tune Kit',
        item_list_name: placement,
        price,
        quantity: 1,
      }],
    });
  });
</script>
